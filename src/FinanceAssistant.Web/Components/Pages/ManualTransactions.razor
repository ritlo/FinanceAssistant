@page "/transactions/manual"
@rendermode InteractiveServer
@implements IDisposable
@using FinanceAssistant.Application.Finance.Categories
@using FinanceAssistant.Application.Finance.Summaries.GetMonthlySummary
@using FinanceAssistant.Application.Finance.Transactions
@using FinanceAssistant.Application.Finance.Transactions.DeleteTransaction
@using FinanceAssistant.Application.Finance.Transactions.LogTransaction
@using FinanceAssistant.Application.Finance.Transactions.UpdateTransaction
@using FinanceAssistant.Domain.Finance.Transactions
@using FinanceAssistant.Web.Finance.Transactions.LogTransaction
@using FinanceAssistant.Web.Finance.Transactions.UpdateTransaction
@using FinanceAssistant.Web.Finance.Transactions
@inject LogTransactionUseCase LogTransaction
@inject UpdateTransactionUseCase UpdateTransaction
@inject DeleteTransactionUseCase DeleteTransaction
@inject TransactionDashboardState DashboardState

<PageTitle>Manual transaction</PageTitle>

<main class="supporting-page transaction-shell">
    <section class="panel transaction-entry">
        <div class="panel-header">
            <div class="panel-title">
                <h2>Manual transaction</h2>
                <p>Log income and expenses against deterministic local categories without using the assistant.</p>
            </div>
            <span class="pill">Manual entry</span>
        </div>

        <div class="panel-body">
            <EditForm Model="Form" OnValidSubmit="SubmitAsync" FormName="log-transaction">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="transaction-grid">
                    <label>
                        <span>Type</span>
                        <InputSelect @bind-Value="Form.Type">
                            <option value="@TransactionType.Expense">Expense</option>
                            <option value="@TransactionType.Income">Income</option>
                        </InputSelect>
                    </label>

                    <label>
                        <span>Amount</span>
                        <InputNumber @bind-Value="Form.Amount" />
                    </label>

                    <label>
                        <span>Date</span>
                        <InputDate @bind-Value="Form.Date" />
                    </label>

                    <label>
                        <span>Category</span>
                        <InputSelect @bind-Value="Form.CategoryId">
                            <option value="">Auto</option>
                            @foreach (var category in Categories.Where(category => category.TransactionType == Form.Type))
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </label>
                </div>

                <label class="description-field">
                    <span>Description</span>
                    <InputText @bind-Value="Form.Description" />
                </label>

                <button type="submit" class="primary-button">Log transaction</button>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="status-message">@StatusMessage</p>
            }
        </div>
    </section>

    @if (Summary is not null)
    {
        <section class="panel monthly-summary">
            <div class="panel-header summary-header">
                <div class="panel-title">
                    <h2>Monthly expenses</h2>
                    <p>@SelectedMonthName @Summary.Year</p>
                </div>
                <div class="summary-controls">
                    <label>
                        <span>Month</span>
                        <input type="number" min="1" max="12" @bind="SelectedMonth" />
                    </label>
                    <label>
                        <span>Year</span>
                        <input type="number" min="1" max="9999" @bind="SelectedYear" />
                    </label>
                    <button type="button" class="secondary-button" @onclick="ApplySummaryPeriodAsync">Apply</button>
                </div>
            </div>

            <div class="panel-body">
                <div class="summary-total">
                    <span>Total expenses</span>
                    <strong>@($"{Summary.ExpenseTotal:0.00}")</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(DashboardState.SummaryErrorMessage))
                {
                    <p class="validation-message">@DashboardState.SummaryErrorMessage</p>
                }

                @if (Summary.Categories.Any())
                {
                    <div class="summary-categories">
                        @foreach (var category in Summary.Categories)
                        {
                            <div class="summary-category-row" @key="category.CategoryId">
                                <span>@category.CategoryName</span>
                                <strong>@($"{category.Total:0.00}")</strong>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-state">No expenses recorded for this month.</p>
                }
            </div>
        </section>
    }

    @if (Transactions.Any())
    {
        <section class="panel transaction-list">
            <div class="panel-header">
                <div class="panel-title">
                    <h2>Recent transactions</h2>
                    <p>Edit or remove locally stored transaction rows.</p>
                </div>
            </div>

            <div class="panel-body list-stack">
                @foreach (var transaction in Transactions)
                {
                    <div class="list-row transaction-row" @key="transaction.Id">
                        @if (EditingId == transaction.Id)
                        {
                            <div class="edit-form">
                                <EditForm Model="EditForm" OnValidSubmit="UpdateAsync" FormName="update-transaction">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <div class="transaction-grid">
                                        <label>
                                            <span>Type</span>
                                            <InputSelect @bind-Value="EditForm.Type">
                                                <option value="@TransactionType.Expense">Expense</option>
                                                <option value="@TransactionType.Income">Income</option>
                                            </InputSelect>
                                        </label>

                                        <label>
                                            <span>Amount</span>
                                            <InputNumber @bind-Value="EditForm.Amount" />
                                        </label>

                                        <label>
                                            <span>Date</span>
                                            <InputDate @bind-Value="EditForm.Date" />
                                        </label>

                                        <label>
                                            <span>Category</span>
                                            <InputSelect @bind-Value="EditForm.CategoryId">
                                                <option value="">Auto</option>
                                                @foreach (var category in Categories.Where(category => category.TransactionType == EditForm.Type))
                                                {
                                                    <option value="@category.Id">@category.Name</option>
                                                }
                                            </InputSelect>
                                        </label>
                                    </div>

                                    <label class="description-field">
                                        <span>Description</span>
                                        <InputText @bind-Value="EditForm.Description" />
                                    </label>

                                    <div class="edit-actions">
                                        <button type="submit" class="primary-button">Save</button>
                                        <button type="button" class="secondary-button cancel-button" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </EditForm>
                            </div>
                        }
                        else
                        {
                            <div class="transaction-details">
                                <span class="transaction-date">@transaction.Date.ToString("yyyy-MM-dd")</span>
                                <span class="transaction-description">@transaction.Description</span>
                                <span class="transaction-category tag">@transaction.CategoryName</span>
                                <span class="transaction-amount @(transaction.Type == TransactionType.Expense ? "amount-expense" : "amount-income")">
                                    @($"{(transaction.Type == TransactionType.Expense ? "-" : "+")}{transaction.Amount:0.00}")
                                </span>
                            </div>
                            <div class="transaction-actions">
                                <button type="button" class="secondary-button edit-button" @onclick="() => StartEdit(transaction)">Edit</button>
                                <button type="button" class="danger-button delete-button" @onclick="() => DeleteAsync(transaction.Id)">Delete</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</main>

@code {
    private LogTransactionFormModel Form { get; } = new();

    private IReadOnlyList<CategoryResult> Categories => DashboardState.Categories;

    private IReadOnlyList<TransactionResult> Transactions => DashboardState.Transactions;

    private GetMonthlySummaryResult? Summary => DashboardState.Summary;

    private string? StatusMessage { get; set; }

    private Guid? EditingId { get; set; }

    private UpdateTransactionFormModel EditForm { get; set; } = new();

    private int SelectedYear { get; set; }

    private int SelectedMonth { get; set; }

    private string SelectedMonthName => DashboardState.SelectedMonthName;

    protected override async Task OnInitializedAsync()
    {
        DashboardState.StateChanged += OnDashboardStateChangedAsync;
        await DashboardState.InitializeAsync();
        SelectedYear = DashboardState.SelectedYear;
        SelectedMonth = DashboardState.SelectedMonth;
    }

    private async Task SubmitAsync()
    {
        var result = await LogTransaction.ExecuteAsync(Form.ToRequest());
        StatusMessage = $"Logged {result.Type.ToString().ToLowerInvariant()} {result.Amount:0.00} in {DashboardState.GetCategoryName(result.CategoryId)}.";
        Form.Description = string.Empty;
        Form.CategoryId = null;
    }

    private void StartEdit(TransactionResult transaction)
    {
        EditingId = transaction.Id;
        EditForm = new UpdateTransactionFormModel
        {
            Id = transaction.Id,
            Amount = transaction.Amount,
            Type = transaction.Type,
            Date = transaction.Date,
            Description = transaction.Description,
            CategoryId = transaction.CategoryId.ToString()
        };
    }

    private void CancelEdit()
    {
        EditingId = null;
    }

    private async Task UpdateAsync()
    {
        if (EditingId is null) return;

        var result = await UpdateTransaction.ExecuteAsync(EditForm.ToRequest());
        EditingId = null;
        StatusMessage = $"Updated {result.Description} to {result.CategoryName}.";
    }

    private async Task DeleteAsync(Guid id)
    {
        await DeleteTransaction.ExecuteAsync(new DeleteTransactionRequest(id));
        StatusMessage = "Transaction deleted.";
    }

    private async Task ApplySummaryPeriodAsync()
    {
        await DashboardState.SetSummaryPeriodAsync(SelectedYear, SelectedMonth);
    }

    private Task OnDashboardStateChangedAsync()
    {
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DashboardState.StateChanged -= OnDashboardStateChangedAsync;
    }
}
